DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=NovaIndustriaDB

JWT_SECRET=tu-secret-super-seguro-cambiame-12345
JWT_EXPIRATION=7d

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:9000,http://localhost:9001

MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# URL del front, usada como redirectUrl del widget de Wompi
FRONTEND_URL=http://localhost:9000

# ── Wompi (pasarela de pago) ────────────────────────────
# Sácalas de tu dashboard de Wompi: Desarrolladores > Secretos.
# En sandbox (WOMPI_ENVIRONMENT=test) no hace falta verificación de negocio,
# solo crear la cuenta y cambiar a modo "Sandbox".
WOMPI_ENVIRONMENT=test
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx